NODE_ENV=development

PORT=3001

# Active Directory
AUTH_MODE=ad                          # Always 'ad' — mock/local authentication is not supported
AD_URL=ldap://ADD-DC.metschool.local  # Use ldaps://ADD-DC.metschool.local:636 for TLS (recommended)
AD_PORT=389
AD_STARTTLS=false                     # Set 'true' to upgrade ldap:// on port 389 to TLS
AD_BASE_DN=DC=metschool,DC=local
AD_USER_SEARCH_BASE=DC=metschool,DC=local
AD_LOGIN_ATTRIBUTE=sAMAccountName
AD_DOMAIN=metschool.local
AD_CONNECT_TIMEOUT_MS=5000

# AD Role Group Mappings (exact group CNs, comma-separated)
AD_ADMIN_GROUPS=Domain Admins,IT Administrators
AD_SUPERVISOR_GROUPS=Maintenance Supervisors,Facilities Management
AD_WORKER_GROUPS=Maintenance Technicians,Maintenance Workers
AD_STOREKEEPER_GROUPS=Store Keepers,Inventory Staff

# AD Department Mappings (optional: GroupCN=DepartmentName)
AD_DEPARTMENT_GROUPS=Elementary Teachers=Elementary Education,High School Teachers=High School Education

# Database
DATABASE_URL=file:./data/maintenance.db

# Microsoft Graph
MICROSOFT_TENANT_ID=d89c1482-0f83-4200-b4ea-a4fafb6bca25
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=maintenance@metropolitanschool.edu.eg

# Session
SESSION_SECRET=
SESSION_MAX_AGE=28800000
SESSION_IDLE_TIMEOUT=3600000

# Uploads
MAX_UPLOAD_SIZE_MB=5