{
  "name": "metropolitan-ticketing-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Metropolitan Ticketing System - backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
