# ============================================================
# Metropolitan Ticketing System - Environment Configuration
# Unified stack: IT Ticketing + Maintenance Management.
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Database (PostgreSQL) ---
# One Postgres server, two databases: the IT ticketing DB and the Maintenance DB.
# Local dev, container:  postgresql://ticketing:ticketing@localhost:5432/<db>
# Docker Compose uses host `db` (see docker-compose.yml) and overrides these.
DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing
MAINTENANCE_DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/maintenance

# --- Postgres service (docker-compose) ---
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing
MAINTENANCE_DB=maintenance
# Host port published to localhost (container always uses 5432 internally).
POSTGRES_PORT=5432
# Published ports for the app services.
BACKEND_PORT=3000
WEB_PORT=8080

# --- JWT ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Active Directory / LDAP (shared by both modules) ---
# The backend reaches AD through the school LAN (NOT through Docker).
AD_URL=ldap://ADD-DC.metschool.local:389
AD_DOMAIN=metschool.local
AD_BASE_DN=DC=metschool,DC=local
AD_USER_SEARCH_BASE=DC=metschool,DC=local
AD_USER_LOGIN_ATTRIBUTE=sAMAccountName
AD_LOGIN_ATTRIBUTE=sAMAccountName
AD_STARTTLS=false
AD_CONNECT_TIMEOUT_MS=5000

# --- AD group membership -> IT role mapping ---
# Comma-separated AD group CNs that grant the IT TECHNICIAN role. Everyone else
# is an IT EMPLOYEE. Exact (case-insensitive) CN match; no fuzzy matching.
AD_TECHNICIAN_GROUPS=IT

# --- AD group membership -> Maintenance role mapping ---
# Priority: ADMIN > SUPERVISOR > WORKER > STORE_KEEPER > EMPLOYEE.
AD_ADMIN_GROUPS=Domain Admins,IT Administrators
AD_SUPERVISOR_GROUPS=Maintenance Supervisors,Facilities Management
AD_WORKER_GROUPS=Maintenance Technicians,Maintenance Workers
AD_STOREKEEPER_GROUPS=Store Keepers,Inventory Staff
# Optional: GroupCN=Department Name pairs; users in the AD group are mapped to the department.
# Department names must match a canonical seeded name (see backend/maintenance/seed.js)
# or a new duplicate department will be created.
AD_DEPARTMENT_GROUPS=Elementary Teachers=Elementary Education,High School Teachers=Secondary Education

# --- Uploads (Maintenance attachments) ---
# Max upload size per attachment (MB). Max 5 attachments per request.
MAX_UPLOAD_SIZE_MB=5

# --- Email notifications (Microsoft Graph preferred) ---
# Graph is used when TENANT_ID + CLIENT_ID + CLIENT_SECRET + SENDER_EMAIL are all set.
# Leave CLIENT_ID / CLIENT_SECRET blank to keep email disabled (safe no-op).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=support@metschool.local

# --- Optional SMTP fallback (used only when Graph is NOT fully configured) ---
# SMTP_SECURE=true means implicit TLS on SMTP_PORT (465); false uses STARTTLS (587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Metropolitan IT Support <support@metschool.local>

# --- Backend entrypoint ---
# Set to "false" to skip reference-data seeding on container startup.
RUN_SEED=true
