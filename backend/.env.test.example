# =============================================================================
# AD authentication & RBAC verification - EXAMPLE configuration
# =============================================================================
# Copy this file to `backend/.env.test` (gitignored) and fill in real values.
#   Copy-Item backend/.env.test.example backend/.env.test
#
# NEVER commit `backend/.env.test`. It is listed in .gitignore.
# These are placeholder values only - no real credentials belong in git.
#
# Any account left blank is reported as SKIP (missing credentials).
# The runner also reads backend/.env to reuse DATABASE_URL / JWT secrets.
# =============================================================================

# Base URL of the running backend. Can also be overridden with `--base-url`.
TEST_BASE_URL=http://localhost:3000

# --- Optional connection overrides ------------------------------------------
# Set these only if the runner must talk to a different DB/backend than
# backend/.env points at (for example the Docker Compose stack).
#DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing
#MAINTENANCE_DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/maintenance
#JWT_ACCESS_SECRET=dev-access-secret-do-not-use-in-production-0001
#JWT_REFRESH_SECRET=dev-refresh-secret-do-not-use-in-production-0002

# --- Positive role matrix ----------------------------------------------------
# <KEY>_USERNAME / <KEY>_PASSWORD : the AD (domain) account to sign in with.
# Optional expectation overrides:
#   <KEY>_EXPECT_IT_ROLE      (EMPLOYEE | TECHNICIAN)
#   <KEY>_EXPECT_IT_LABEL     (role label, e.g. Academic | IT)
#   <KEY>_EXPECT_MAINT_ROLE   (EMPLOYEE | SUPERVISOR | MAINTENANCE_WORKER | STORE_KEEPER | ADMIN)
#   <KEY>_EXPECT_DEPARTMENT   (expected resolved department name, if any)

# 1. IT employee (NOT a member of the IT group)
IT_EMPLOYEE_USERNAME=
IT_EMPLOYEE_PASSWORD=

# 2. IT technician (member of AD_TECHNICIAN_GROUPS, e.g. "IT")
IT_TECHNICIAN_USERNAME=
IT_TECHNICIAN_PASSWORD=

# 3. Maintenance supervisor
MAINT_SUPERVISOR_USERNAME=
MAINT_SUPERVISOR_PASSWORD=

# 5. Store keeper
MAINT_STOREKEEPER_USERNAME=    
MAINT_STOREKEEPER_PASSWORD=


